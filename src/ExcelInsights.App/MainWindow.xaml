<Window x:Class="ExcelInsights.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Excel Insights · Excel 統計工作台" Width="1240" Height="850" MinWidth="1040" MinHeight="720"
 FontFamily="Microsoft JhengHei UI, Segoe UI" FontSize="13" Background="#F2F5FA"
 AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#14233D" Padding="22,28">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top">
     <TextBlock Text="▦  EXCEL INSIGHTS" Foreground="#96BAFF" FontSize="17" FontWeight="Bold"/>
     <TextBlock Text="資料統計工作台" Foreground="White" FontSize="24" Margin="0,10,0,24"/>
     <Button Content="＋ 匯入 Excel 檔案" Click="Import_Click" x:Name="ImportButton" Background="#598BFF" Foreground="White" Margin="0,0,0,12"/>
     <TextBlock Text="可一次選取多檔，或拖曳檔案至視窗" Foreground="#B5C3DC" TextWrapping="Wrap" Margin="0,0,0,20"/>
     <TextBlock Text="檔案 / 工作表" Foreground="#B5C3DC" Margin="0,0,0,10"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
     <Button Content="移除選取工作表" Click="Remove_Click" Margin="0,0,0,8"/>
     <Button Content="清除全部" Click="Clear_Click" Margin="0,0,0,16"/>
     <TextBlock Text="資料在本機處理，不上傳雲端。&#10;首列視為欄名；不修改來源檔。" Foreground="#B5C3DC" TextWrapping="Wrap" FontSize="12"/>
    </StackPanel>
    <ListBox x:Name="SheetsList" DisplayMemberPath="DisplayName" SelectionChanged="Sheet_Changed"
      Background="#1D304E" Foreground="White" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="26,24">
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
    <RowDefinition Height="1.2*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,18">
    <TextBlock Text="從試算表，到清楚的答案。" FontSize="27" FontWeight="SemiBold"/>
    <TextBlock Text="選擇工作表與數值欄位，依需要篩選或分組。統計僅計算目前選取的工作表。" Margin="0,8,0,0" Foreground="#63718A"/>
   </StackPanel>
   <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,12">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="數值欄位" Margin="0,0,0,6"/><ComboBox x:Name="NumericColumn" SelectionChanged="Options_Changed"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="分組欄位（可選）" Margin="0,0,0,6"/><ComboBox x:Name="GroupColumn" SelectionChanged="Options_Changed"/></StackPanel>
     <Button Grid.Column="4" Content="匯出統計 CSV" Click="Export_Click" x:Name="ExportButton" IsEnabled="False" VerticalAlignment="Bottom" Margin="0"/>
    </Grid>
   </Border>
   <Grid Grid.Row="2" Margin="0,0,0,10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ComboBox x:Name="FilterColumn" Margin="0,0,8,0" SelectionChanged="Options_Changed" ToolTip="篩選欄位"/>
    <TextBox Grid.Column="1" x:Name="FilterText" TextChanged="Filter_Changed" Padding="9,6" ToolTip="輸入包含文字，不區分大小寫；清空以顯示全部"/>
    <Button Grid.Column="2" Content="清除篩選" Click="ResetFilter_Click" Margin="8,0,0,0"/>
   </Grid>
   <DataGrid Grid.Row="3" x:Name="PreviewGrid" AutoGeneratingColumn="Preview_AutoGeneratingColumn"/>
   <TextBlock Grid.Row="4" x:Name="SummaryHeading" Text="統計結果" FontSize="17" FontWeight="SemiBold" Margin="0,16,0,10"/>
   <DataGrid Grid.Row="5" x:Name="SummaryGrid" AutoGenerateColumns="False">
    <DataGrid.Columns>
     <DataGridTextColumn Header="群組" Binding="{Binding Group}" Width="*"/>
     <DataGridTextColumn Header="筆數" Binding="{Binding Rows}"/>
     <DataGridTextColumn Header="有效數值" Binding="{Binding NumericCount}"/>
     <DataGridTextColumn Header="空白" Binding="{Binding BlankCount}"/>
     <DataGridTextColumn Header="非數值" Binding="{Binding InvalidCount}"/>
     <DataGridTextColumn Header="總和" Binding="{Binding Sum, StringFormat={}{0:N2}}"/>
     <DataGridTextColumn Header="平均" Binding="{Binding Average, StringFormat={}{0:N2}}"/>
     <DataGridTextColumn Header="最小" Binding="{Binding Minimum, StringFormat={}{0:N2}}"/>
     <DataGridTextColumn Header="最大" Binding="{Binding Maximum, StringFormat={}{0:N2}}"/>
    </DataGrid.Columns>
   </DataGrid>
   <TextBlock Grid.Row="6" x:Name="StatusText" Text="尚未匯入資料。請選取 Excel 檔案開始。" Foreground="#63718A" TextWrapping="Wrap" Margin="0,12,0,0"/>
  </Grid>
 </Grid>
</Window>
